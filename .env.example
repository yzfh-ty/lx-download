# 必填：请替换为随机且足够长的 Web 访问 Token。
WEBPLAYER_TOKEN=CHANGE_ME_TO_A_RANDOM_TOKEN

# 镜像标签：latest 或具体版本，例如 0.0.1。
LX_IMAGE_TAG=latest

# 宿主机端口和容器名称。
HOST_PORT=9527
CONTAINER_NAME=lx-download-server

# 宿主机持久化目录，可改为绝对路径。
DATA_DIR=./data
CACHE_DIR=./cache
DOWNLOAD_DIR=./download
LOG_DIR=./logs

# 可选运行配置。
PORT=9527
BIND_IP=0.0.0.0
PLAYER_PATH=/
ENABLE_CACHE_SIZE_LIMIT=false
CACHE_SIZE_LIMIT=2000
PROXY_HEADER=x-real-ip
PROXY_ALL_ENABLED=false
PROXY_ALL_ADDRESS=
SINGER_SOURCE_PRIORITY=tx,wy
