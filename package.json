{
  "name": "lx-download",
  "private": true,
  "scripts": {
    "test:resources": "node scripts/test-resource-cleanup.cjs",
    "test:memory": "node --expose-gc scripts/test-cover-memory.cjs",
    "test:review": "node scripts/test-review-regressions.cjs",
    "test:playlist-sync": "node scripts/test-playlist-sync.cjs",
    "test:navidrome": "node scripts/test-navidrome-sync.cjs",
    "build": "rimraf server && tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node ./index.js",
    "dev": "nodemon",
    "dev1": "nodemon --exec \"tsx --inspect=127.0.0.1:9301 ./src/index.ts\"",
    "dev2": "nodemon --exec \"cmd /c start /affinity 1 /b /wait tsx --inspect=127.0.0.1:9302 ./src/index.ts\"",
    "prd": "pm2 start ecosystem.config.js --env production"
  },
  "engines": {
    "node": ">= 22.5.0",
    "npm": ">= 8.5.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzfh-ty/lx-download.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/yzfh-ty/lx-download/issues"
  },
  "homepage": "https://github.com/yzfh-ty/lx-download#readme",
  "dependencies": {
    "crypto-js": "^4.2.0",
    "file-type": "^22.0.1",
    "iconv-lite": "^0.6.3",
    "image-size": "^1.2.1",
    "log4js": "^6.9.1",
    "lru-cache": "^10.0.1",
    "module-alias": "^2.3.4",
    "music-metadata": "^11.15.0",
    "music-tag-native": "^0.2.5",
    "needle": "^3.3.1",
    "node-id3": "^0.2.9",
    "socks-proxy-agent": "^10.1.0",
    "tunnel": "^0.0.6",
    "vm2": "^3.11.4"
  },
  "devDependencies": {
    "@tsconfig/node16": "^16.1.1",
    "@types/module-alias": "^2.0.4",
    "@types/needle": "^3.3.0",
    "@types/tunnel": "^0.0.7",
    "nodemon": "^3.1.14",
    "rimraf": "^5.0.5",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "nodemonConfig": {
    "ext": "js,ts",
    "ignore": [
      "data/",
      "logs/",
      "config.js"
    ],
    "exec": "npx tsx ./src/index.ts"
  }
}
